{
  "name": "graft-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Graft remote you deploy to your own Cloudflare account.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/eidos-space/graft-cloudflare",
  "cloudflare": {
    "bindings": {
      "OBJECTS": {
        "description": "Private storage for your Graft repository objects. R2 activation is required; usage beyond its included allowance is billed by Cloudflare."
      }
    }
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "setup:local": "node scripts/setup-local.mjs",
    "token": "node scripts/token.mjs",
    "types": "wrangler types worker-configuration.d.ts --include-runtime false --env-file .dev.vars.example",
    "check": "wrangler types worker-configuration.d.ts --include-runtime false --env-file .dev.vars.example --check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "smoke:sdk": "node scripts/smoke-sdk.mjs"
  },
  "dependencies": {
    "@eidos.space/graft-remote": "0.2.6",
    "@eidos.space/graft-remote-cloudflare": "0.2.6",
    "@eidos.space/graft-remote-hono": "0.2.6",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "20.19.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.155.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
